# Google OAuth for Web Application (for backend token exchange)
GOOGLE_CLIENT_ID_WEB=your_web_client_id_here
GOOGLE_CLIENT_SECRET_WEB=your_web_client_secret_here

# Google OAuth for Desktop App (public client)
GOOGLE_CLIENT_ID_DESKTOP=your_desktop_client_id_here

# Google OAuth for Android (public client)
GOOGLE_CLIENT_ID_ANDROID=your_android_client_id_here

# Google OAuth for iOS (public client)
GOOGLE_CLIENT_ID_IOS=your_ios_client_id_here

# Backend configuration
JWT_SECRET_KEY=your_super_secret_jwt_key_change_this
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60
REFRESH_TOKEN_EXPIRATION_DAYS=30

# Server configuration
API_BASE_URL=http://localhost:8000