
# Clara Core Environment Configuration Template

# Copy this file to .env (or .env.local / .env.development) and fill in your values.


# Server & API Configuration

HOST=0.0.0.0
PORT=8000
API_BASE_URL=http://localhost:8000
ENVIRONMENT=development
DEBUG=True


# Authentication & Session Security (JWT)

# Secret key used for signing session tokens
JWT_SECRET_KEY=your_super_secret_jwt_key_change_this
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60
REFRESH_TOKEN_EXPIRATION_DAYS=30


# Google OAuth 2.0 Client Credentials

# Web Client Flow (Client Secret based)
GOOGLE_CLIENT_ID_WEB=your_web_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET_WEB=your_web_client_secret

# Desktop Client Flow (Public Client / Localhost Callback)
GOOGLE_CLIENT_ID_DESKTOP=your_desktop_client_id.apps.googleusercontent.com

# Android Client Flow (Primary target - Public Client with PKCE)
GOOGLE_CLIENT_ID_ANDROID=your_android_client_id.apps.googleusercontent.com

# iOS Client Flow (Public Client with custom URI scheme)
GOOGLE_CLIENT_ID_IOS=your_ios_client_id.apps.googleusercontent.com

# OAuth Endpoints & Redirects
AUTH_URI=https://accounts.google.com/o/oauth2/auth
TOKEN_URI=https://oauth2.googleapis.com/token
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback


# LLM & AI Agent Provider Configuration

# OpenRouter API Key (Primary LLM routing)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenAI API Key (Optional fallback)
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini API Key (Optional fallback)
GEMINI_API_KEY=your_gemini_api_key_here

# Default Model for Clara Agent
CLARA_DEFAULT_MODEL=google/gemini-flash-1.5
